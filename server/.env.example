PORT=4000

# Set to true only when people open NexFlow through https:// (makes the session cookie Secure)
USE_HTTPS=false

# CouchDB
COUCH_HOST=http://your-couch-host:5984
COUCH_USER=admin
COUCH_PASSWORD=change-me
DB_NAME=nexflow_db

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The address the browser uses to open the app
CLIENT_ORIGIN=http://localhost:5173

# Where uploaded images are stored (local folder or network share)
UPLOAD_DIR=

# Images bigger than this (in bytes) are hidden behind a "Show" button. 1048576 = 1 MB
LARGE_IMAGE_BYTES=1048576
